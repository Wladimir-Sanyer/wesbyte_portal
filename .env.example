# Configuración del Servidor Wesbyte Portal (Puerto 8085 para no chocar con 8080 de broker-pmp-app)
PORT=8085
WORKERS=2
SECRET_KEY=wesbyte-portal-jwt-secret-key-2026
APP_VERSION=v1.0.0
WESBYTE_APP_URL=http://localhost:8080
SOPORTE_EMAIL=soporte@wesbyte.app

# Google Cloud / BigQuery
BIGQUERY_PROJECT_ID=broker-pmp
WESBYTES_DATASET_ID=wesbytes
TEMPLATE_DATASET_ID=broker_pmp
GOOGLE_APPLICATION_CREDENTIALS=.secrets/broker-pmp-2aec3024d9c6.json

# PayPhone Pasarela de Pagos (Pago Único Anual -10% + Suscripción Mensual Recurrente)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_API_URL=https://pay.payphonetodoesfacil.com/api
PAYPHONE_REDIRECT_URL=http://localhost:8085/checkout/payphone/callback
PAYPHONE_SANDBOX_MODE=true

# Acceso interno al panel /panel-clientes (define usuario y clave; si se dejan vacios el panel queda deshabilitado)
PORTAL_STAFF_USER=
PORTAL_STAFF_PASSWORD=
