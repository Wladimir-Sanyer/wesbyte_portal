# Configuración del Servidor Portal Wesbyte (Puerto 8085)
PORT=8085
WORKERS=2
SECRET_KEY=wesbyte-portal-jwt-secret-key-2026
APP_VERSION=v1.0.0
WESBYTE_APP_URL=https://portal.wesbyte.app
SOPORTE_EMAIL=soporte@wesbyte.app

# Google Cloud / BigQuery
BIGQUERY_PROJECT_ID=wesbyte
WESBYTES_DATASET_ID=administracion
TEMPLATE_DATASET_ID=prototipo
GOOGLE_APPLICATION_CREDENTIALS=.secrets/wesbyte-e1e002799cb2.json

# PayPhone Pasarela de Pagos (Pago Único Anual -10% + Suscripción Mensual Recurrente)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_API_URL=https://pay.payphonetodoesfacil.com/api
PAYPHONE_REDIRECT_URL=https://wesbyte.app/checkout/payphone/callback
PAYPHONE_SANDBOX_MODE=true

# Acceso interno al panel /panel-clientes (define usuario y clave; si se dejan vacios el panel queda deshabilitado)
PORTAL_STAFF_USER=
PORTAL_STAFF_PASSWORD=

# Servicio de Notificaciones Transaccionales (Resend)
RESEND_API_KEY=re_...
INTERNAL_EMAIL_SERVICE_KEY=your-internal-email-service-secret-key
EMAIL_SENDER_DEFAULT=Wesbyte <notifications@wesbyte.app>
GCP_PROJECT_ID=wesbyte
WESBYTE_CENTRAL_DATASET=administracion

# Google Drive (Almacenamiento de logos de clientes en clientes/logos)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Gemini IA (Editor Inteligente de Plantillas de Correo)
GEMINI_API_KEY=
GEMINI_MODEL_EMAIL=gemini-3.8-flash

# Facturación Electrónica SRI Ecuador (Esquema Offline v1.1.0 / v2.1.0)
SRI_AMBIENTE=1
SRI_P12_PATH=/app/.secrets/firma_electronica.p12
SRI_P12_PASSWORD=
SRI_RUC_EMISOR=
SRI_RAZON_SOCIAL=
SRI_NOMBRE_COMERCIAL=
SRI_DIR_MATRIZ=
SRI_DIR_ESTABLECIMIENTO=
SRI_ESTABLECIMIENTO=001
SRI_PUNTO_EMISION=001
SRI_OBLIGADO_CONTABILIDAD=SI
SRI_CONTRIBUYENTE_RIMPE=
SRI_INVOICE_HOUR_ECUADOR=01:00

